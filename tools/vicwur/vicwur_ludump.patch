diff -ruN -x '*.o' a/vic/plugins/landuse/src/lu_dump.c b/vic/plugins/landuse/src/lu_dump.c
--- a/vic/plugins/landuse/src/lu_dump.c	1970-01-01 05:30:00.000000000 +0530
+++ b/vic/plugins/landuse/src/lu_dump.c	2026-10-16 11:41:54.000000000 +0530
@@ -0,0 +1,261 @@
+/******************************************************************************
+ * @section DESCRIPTION
+ *
+ * Dump-only instrumentation of lu_apply (TorchVIC).
+ * Writes every state lu_apply reads or writes, before (phase 0) and after
+ * (phase 1) each call, to a binary file for the level-2 replay test
+ * (tests/test_vicwur_landuse_l2.py).  Active only when the environment
+ * variable VICWUR_LUDUMP names an output file; otherwise it returns at once.
+ * It only reads model state.
+ *
+ * File format: sequence of records  int32 tag, int64 n, n x float64.
+ *   tag 30 dims (once): nc ntmax nb nl nn nf nimax R rps uh NVEGTYPES Pbare
+ *          IRRIGATION ROUTING FULL_ENERGY SNOW_MAX_SURFACE_SWE SNOW_DENSITY dt
+ *          SNOW_NEW_SNOW_DENS_MAX
+ *   tag 31 statics (once), per cell: nv_active area lat FS_ACTIVE;
+ *          tile[ntmax]: veg_class overstory; band[nb]: AreaFract Tfactor;
+ *          layer[nl]: max_moist depth bulk_density soil_density organic
+ *          quartz bulk_dens_min soil_dens_min; node[nn]: dz_node Zsum_node
+ *          max_moist_node expt_node bubble_node; frost_fract[nf];
+ *          ni_active; irr[nimax]: veg_index paddy
+ *   tag 32 call: current year month day day_in_year air_temp[NR] of every
+ *          cell
+ *   tag 33/34 state before/after, per cell: Cv[ntmax] lu_force.Cv[ntmax];
+ *          tile x band: Wdew swq pack_water surf_water snow_canopy
+ *          coldcontent density depth last_snow MELTING surf_temp pack_temp
+ *          AnnualNPP AnnualNPPPrev CLitter CInter CSlow LAI moist[nl]
+ *          ice[nl][nf] T[nn]; leftover[nimax][nb]; dt_discharge[R]
+ *          discharge stream
+ *   (absent tiles/entries are NaN)
+ *****************************************************************************/
+
+#include <vic_driver_image.h>
+#include <plugin.h>
+#include <math.h>
+
+static FILE *ludump = NULL;
+static int   ludump_init = 0;
+
+static void
+lu_rec(int tag, size_t n, const double *d)
+{
+    int32_t t = (int32_t) tag;
+    int64_t m = (int64_t) n;
+
+    fwrite(&t, sizeof(t), 1, ludump);
+    fwrite(&m, sizeof(m), 1, ludump);
+    fwrite(d, sizeof(double), n, ludump);
+}
+
+void
+lu_dump(int phase)
+{
+    extern domain_struct              local_domain;
+    extern option_struct              options;
+    extern parameters_struct          param;
+    extern global_param_struct        global_param;
+    extern plugin_option_struct       plugin_options;
+    extern plugin_global_param_struct plugin_global_param;
+    extern all_vars_struct           *all_vars;
+    extern soil_con_struct           *soil_con;
+    extern veg_con_map_struct        *veg_con_map;
+    extern veg_con_struct           **veg_con;
+    extern veg_lib_struct           **veg_lib;
+    extern lu_force_struct           *lu_force;
+    extern force_data_struct         *force;
+    extern size_t                     NR;
+    extern size_t                     current;
+    extern dmy_struct                *dmy;
+
+    size_t nc = local_domain.ncells_active;
+    size_t nb = options.SNOW_BAND, nl = options.Nlayer, nn = options.Nnode;
+    size_t nf = options.Nfrost;
+    size_t nt = 0, ni = 0, R = 0, rps = 0;
+    size_t i, t, b, l, f, n, k, p, sz;
+    double *buf, nan = NAN;
+
+    if (!ludump_init) {
+        const char *fn = getenv("VICWUR_LUDUMP");
+        ludump_init = 1;
+        if (fn != NULL && fn[0] != '\0') {
+            ludump = fopen(fn, "wb");
+        }
+    }
+    if (ludump == NULL) {
+        return;
+    }
+    for (i = 0; i < nc; i++) {
+        if (veg_con_map[i].nv_active > nt) {
+            nt = veg_con_map[i].nv_active;
+        }
+        if (plugin_options.IRRIGATION && irr_con_map[i].ni_active > ni) {
+            ni = irr_con_map[i].ni_active;
+        }
+    }
+    if (plugin_options.ROUTING) {
+        rps = plugin_global_param.rout_steps_per_day /
+              global_param.model_steps_per_day;
+        R = plugin_options.UH_LENGTH + rps - 1;
+    }
+
+    if (phase == 0 && ludump_init == 1) {
+        double d[19] = {(double) nc, (double) nt, (double) nb, (double) nl,
+                        (double) nn, (double) nf, (double) ni, (double) R,
+                        (double) rps, (double) plugin_options.UH_LENGTH,
+                        (double) options.NVEGTYPES,
+                        (double) plugin_options.Pbare,
+                        (double) plugin_options.IRRIGATION,
+                        (double) plugin_options.ROUTING,
+                        (double) options.FULL_ENERGY,
+                        param.SNOW_MAX_SURFACE_SWE,
+                        (double) options.SNOW_DENSITY, global_param.dt,
+                        param.SNOW_NEW_SNOW_DENS_MAX};
+        lu_rec(30, 19, d);
+        sz = nc * (4 + 2 * nt + 2 * nb + 8 * nl + 5 * nn + nf + 1 + 2 * ni);
+        buf = malloc(sz * sizeof(double));
+        p = 0;
+        for (i = 0; i < nc; i++) {
+            buf[p++] = (double) veg_con_map[i].nv_active;
+            buf[p++] = local_domain.locations[i].area;
+            buf[p++] = soil_con[i].lat;
+            buf[p++] = (double) soil_con[i].FS_ACTIVE;
+            for (t = 0; t < nt; t++) {
+                if (t < veg_con_map[i].nv_active) {
+                    int vc = veg_con[i][t].veg_class;
+                    buf[p++] = (double) vc;
+                    buf[p++] = vc < (int) options.NVEGTYPES ?
+                               (double) veg_lib[i][vc].overstory : 0.;
+                }
+                else {
+                    buf[p++] = nan;
+                    buf[p++] = nan;
+                }
+            }
+            for (b = 0; b < nb; b++) {
+                buf[p++] = soil_con[i].AreaFract[b];
+                buf[p++] = soil_con[i].Tfactor[b];
+            }
+            for (l = 0; l < nl; l++) {
+                buf[p++] = soil_con[i].max_moist[l];
+                buf[p++] = soil_con[i].depth[l];
+                buf[p++] = soil_con[i].bulk_density[l];
+                buf[p++] = soil_con[i].soil_density[l];
+                buf[p++] = soil_con[i].organic[l];
+                buf[p++] = soil_con[i].quartz[l];
+                buf[p++] = soil_con[i].bulk_dens_min[l];
+                buf[p++] = soil_con[i].soil_dens_min[l];
+            }
+            for (n = 0; n < nn; n++) {
+                buf[p++] = soil_con[i].dz_node[n];
+                buf[p++] = soil_con[i].Zsum_node[n];
+                buf[p++] = soil_con[i].max_moist_node[n];
+                buf[p++] = soil_con[i].expt_node[n];
+                buf[p++] = soil_con[i].bubble_node[n];
+            }
+            for (f = 0; f < nf; f++) {
+                buf[p++] = soil_con[i].frost_fract[f];
+            }
+            buf[p++] = plugin_options.IRRIGATION ?
+                       (double) irr_con_map[i].ni_active : 0.;
+            for (k = 0; k < ni; k++) {
+                if (k < irr_con_map[i].ni_active) {
+                    buf[p++] = (double) irr_con[i][k].veg_index;
+                    buf[p++] = (double) irr_con[i][k].paddy;
+                }
+                else {
+                    buf[p++] = nan;
+                    buf[p++] = nan;
+                }
+            }
+        }
+        lu_rec(31, p, buf);
+        free(buf);
+        ludump_init = 2;
+    }
+
+    if (phase == 0) {
+        buf = malloc((5 + nc) * sizeof(double));
+        buf[0] = (double) current;
+        buf[1] = (double) dmy[current].year;
+        buf[2] = (double) dmy[current].month;
+        buf[3] = (double) dmy[current].day;
+        buf[4] = (double) dmy[current].day_in_year;
+        for (i = 0; i < nc; i++) {
+            buf[5 + i] = force[i].air_temp[NR];
+        }
+        lu_rec(32, 5 + nc, buf);
+        free(buf);
+    }
+
+    k = 18 + nl + nl * nf + nn;
+    sz = nc * (2 * nt + nt * nb * k + ni * nb + R + 2);
+    buf = malloc(sz * sizeof(double));
+    p = 0;
+    for (i = 0; i < nc; i++) {
+        size_t nv = veg_con_map[i].nv_active;
+        for (t = 0; t < nt; t++) {
+            buf[p++] = t < nv ? veg_con[i][t].Cv : nan;
+        }
+        for (t = 0; t < nt; t++) {
+            buf[p++] = t < nv ? lu_force[i].Cv[t] : nan;
+        }
+        for (t = 0; t < nt; t++) {
+            for (b = 0; b < nb; b++) {
+                if (t >= nv) {
+                    for (n = 0; n < k; n++) {
+                        buf[p++] = nan;
+                    }
+                    continue;
+                }
+                veg_var_struct    *vv = &all_vars[i].veg_var[t][b];
+                cell_data_struct  *cd = &all_vars[i].cell[t][b];
+                snow_data_struct  *sn = &all_vars[i].snow[t][b];
+                energy_bal_struct *en = &all_vars[i].energy[t][b];
+                buf[p++] = vv->Wdew;
+                buf[p++] = sn->swq;
+                buf[p++] = sn->pack_water;
+                buf[p++] = sn->surf_water;
+                buf[p++] = sn->snow_canopy;
+                buf[p++] = sn->coldcontent;
+                buf[p++] = sn->density;
+                buf[p++] = sn->depth;
+                buf[p++] = (double) sn->last_snow;
+                buf[p++] = (double) sn->MELTING;
+                buf[p++] = sn->surf_temp;
+                buf[p++] = sn->pack_temp;
+                buf[p++] = vv->AnnualNPP;
+                buf[p++] = vv->AnnualNPPPrev;
+                buf[p++] = cd->CLitter;
+                buf[p++] = cd->CInter;
+                buf[p++] = cd->CSlow;
+                buf[p++] = vv->LAI;
+                for (l = 0; l < nl; l++) {
+                    buf[p++] = cd->layer[l].moist;
+                }
+                for (l = 0; l < nl; l++) {
+                    for (f = 0; f < nf; f++) {
+                        buf[p++] = cd->layer[l].ice[f];
+                    }
+                }
+                for (n = 0; n < nn; n++) {
+                    buf[p++] = en->T[n];
+                }
+            }
+        }
+        for (t = 0; t < ni; t++) {
+            for (b = 0; b < nb; b++) {
+                buf[p++] = (plugin_options.IRRIGATION &&
+                            t < irr_con_map[i].ni_active) ?
+                           irr_var[i][t][b].leftover : nan;
+            }
+        }
+        for (t = 0; t < R; t++) {
+            buf[p++] = rout_var[i].dt_discharge[t];
+        }
+        buf[p++] = R > 0 ? rout_var[i].discharge : nan;
+        buf[p++] = R > 0 ? rout_var[i].stream : nan;
+    }
+    lu_rec(phase == 0 ? 33 : 34, p, buf);
+    free(buf);
+    fflush(ludump);
+}
