From d0117e0218233205bd1ad7bcbbb837b700ec3d07 Mon Sep 17 00:00:00 2001
From: Barbhuiya12 <siddikbarbhuiya@gmail.com>
Date: Tue, 17 Nov 2026 14:27:00 +0530
Subject: [PATCH] rout_rvic: rotate and zero the whole routing ring

The routing ring has full_time_length rows (rout_alloc.c) and RVIC rolls
all of them (np.roll(ring, -1, axis=0)), but convolution() called
cshift() with n_timesteps, so only the first n_timesteps rows were
rotated. A source with source_time_offset > 0 adds its unit hydrograph to
rows offset .. offset + n_timesteps - 1; what lands on rows >=
n_timesteps was never moved to row 0, which is the row read as discharge,
and was lost. With an offset equal to the unit hydrograph length all of
the water of the source was lost.

Rotate full_time_length rows. rout_init() zeroed only the first
n_timesteps rows of the (malloc'ed) ring, so zero all full_time_length
rows as well, otherwise the rotation would move uninitialised values to
row 0.
---
 vic/extensions/rout_rvic/src/rout_convolution.c | 4 ++--
 vic/extensions/rout_rvic/src/rout_init.c        | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/vic/extensions/rout_rvic/src/rout_convolution.c b/vic/extensions/rout_rvic/src/rout_convolution.c
index 6d995549..6c524659 100644
--- a/vic/extensions/rout_rvic/src/rout_convolution.c
+++ b/vic/extensions/rout_rvic/src/rout_convolution.c
@@ -30,8 +30,8 @@ convolution(double *runoff,
 
     // Equivalent to Fortran 90 cshift function, in python: (from variables.py)
     // self.ring[tracer] = np.roll(self.ring[tracer], -1, axis=0)
-    cshift(rout.ring, rout.rout_param.n_timesteps, rout.rout_param.n_outlets, 0,
-           1);
+    cshift(rout.ring, rout.rout_param.full_time_length,
+           rout.rout_param.n_outlets, 0, 1);
 
     /*Loop through all sources*/
     for (i_source = 0; i_source < rout.rout_param.n_sources; i_source++) {
diff --git a/vic/extensions/rout_rvic/src/rout_init.c b/vic/extensions/rout_rvic/src/rout_init.c
index 2ae478d4..f96983b2 100644
--- a/vic/extensions/rout_rvic/src/rout_init.c
+++ b/vic/extensions/rout_rvic/src/rout_init.c
@@ -49,8 +49,8 @@ rout_init(void)
 
         // The Ring
         for (j = 0; j < rout.rout_param.n_outlets; j++) {
-            for (i = 0; i < rout.rout_param.n_timesteps; i++) {
-                rout.ring[j * rout.rout_param.n_timesteps + i] = 0.0;
+            for (i = 0; i < rout.rout_param.full_time_length; i++) {
+                rout.ring[j * rout.rout_param.full_time_length + i] = 0.0;
             }
         }
 
